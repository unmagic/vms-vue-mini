{
  "name": "@unmagic/vue-mini",
  "version": "1.0.2",
  "description": "基于 Vue 3 的小程序框架。简单，强大，高性能。 ",
  "main": "dist/vue-mini.cjs.js",
  "module": "dist/vue-mini.esm-bundler.js",
  "types": "dist/vue-mini.d.ts",
  "repository": "https://github.com/unmagic/vms-vue-mini.git",
  "author": "Liu Biao <1178545208@qq.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/vue-mini.d.ts",
      "import": "./dist/vue-mini.esm-bundler.js",
      "require": "./dist/vue-mini.cjs.js",
      "default": "./dist/vue-mini.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "vue",
    "mini",
    "vms",
    "wechat",
    "weixin",
    "miniprogram",
    "mp",
    "微信",
    "小程序"
  ],
  "dependencies": {
    "@vue/reactivity": "3.5.33",
    "miniprogram-api-typings": "~5.1.3"
  }
}
